{
  "expo": {
    "name": "Shree Hari Crackers",
    "slug": "fatakda-kit",
    "version": "1.0.0",
    "scheme": "fatakdakit",
    "orientation": "portrait",
    "icon": "./assets/shc-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "com.fatakda.kit",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.fatakda.kit",
      "adaptiveIcon": {
        "backgroundColor": "#8B0005",
        "foregroundImage": "./assets/shc-adaptive-fg.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "./plugins/with-scene-lifecycle",
      [
        "expo-splash-screen",
        {
          "image": "./assets/hp-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "./plugins/withServerCert",
        {
          "certPaths": [
            "certs/server_cert.pem"
          ],
          "hosts": [
            "64.227.168.97"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://64.227.168.97"
    },
    "backgroundColor": "#FFF9F5"
  }
}
