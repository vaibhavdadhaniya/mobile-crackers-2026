{
  "expo": {
    "name": "Shree Hari Crackers",
    "slug": "fatakda-kit",
    "version": "1.0.0",
    "scheme": "fatakdakit",
    "orientation": "portrait",
    "icon": "./assets/shc-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "deploymentTarget": "16.4",
      "buildNumber": "1",
      "bundleIdentifier": "com.app.hpym2024",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "Crackers Stock",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Crackers Stock uses the local network to connect to the development server.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.stock.crackers",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#8B0005",
        "foregroundImage": "./assets/shc-adaptive-fg.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-font",
      "./plugins/with-scene-lifecycle",
      "./plugins/withIosBuildSettingsVersion",
      "./plugins/withReleaseSigning",
      [
        "./plugins/withAndroidAppName",
        {
          "name": "Cracker Stock"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "./plugins/withServerCert",
        {
          "certPaths": [
            "certs/server_cert.pem"
          ],
          "hosts": [
            "64.227.168.97"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F97316"
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Shree Hari Crackers to save report images to your photos.",
          "savePhotosPermission": "Allow Shree Hari Crackers to save report images to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://64.227.168.97",
      "firebase": {
        "projectId": "hpym2024-7cfda",
        "firestoreDb": "harimaypradesh",
        "apiKey": "AIzaSyCQwGATP8oxkZE4yPQHyJeQDEYMdQgffHs"
      }
    },
    "backgroundColor": "#FFF9F5"
  }
}
